PORT=5000
NODE_ENV=development

# Database connection: Local PostgreSQL or Supabase Connection String
# Example Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Example Local: postgres://postgres@localhost:5432/event_reservation
DATABASE_URL=postgres://postgres@localhost:5432/event_reservation

# JWT Secret
JWT_SECRET=super_secret_jwt_key_event_reservation_system_2026

# Upstash Redis (Optional - falls back automatically to local in-memory Redis cache if empty)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Ticket Hold Expiration Duration in Minutes (default: 10)
RESERVATION_EXPIRY_MINUTES=10
